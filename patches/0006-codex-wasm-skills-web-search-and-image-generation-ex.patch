From 645d3bc693b3fd199cbfe792d8b287eab727086e Mon Sep 17 00:00:00 2001
From: k4c <sebk4c@tuta.com>
Date: Mon, 19 Oct 2026 04:56:20 +0000
Subject: [PATCH 6/6] codex-wasm: skills, web search and image generation
 extensions in the tab's sessions

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 codex-rs/wasm/Cargo.toml |  4 ++++
 codex-rs/wasm/src/lib.rs | 19 ++++++++++++++++++-
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/codex-rs/wasm/Cargo.toml b/codex-rs/wasm/Cargo.toml
index d6523f5..3636ce9 100644
--- a/codex-rs/wasm/Cargo.toml
+++ b/codex-rs/wasm/Cargo.toml
@@ -13,7 +13,11 @@ doctest = false
 anyhow = { workspace = true }
 codex-core = { workspace = true }
 codex-core-api = { workspace = true }
+codex-features = { workspace = true }
+codex-image-generation-extension = { workspace = true }
 codex-protocol = { workspace = true }
+codex-skills-extension = { workspace = true }
+codex-web-search-extension = { workspace = true }
 codex-wasm-host = { path = "../../../crates/codex-wasm-host" }
 serde = { workspace = true, features = ["derive"] }
 serde_json = { workspace = true }
diff --git a/codex-rs/wasm/src/lib.rs b/codex-rs/wasm/src/lib.rs
index a17020c..a2e6fdc 100644
--- a/codex-rs/wasm/src/lib.rs
+++ b/codex-rs/wasm/src/lib.rs
@@ -222,7 +222,24 @@ async fn run() -> anyhow::Result<()> {
     let user_instructions_provider = Arc::new(CodexHomeUserInstructionsProvider::new(
         config.codex_home.clone(),
     ));
-    let extensions = ExtensionRegistryBuilder::<codex_core::config::Config>::new();
+    // The extensions the CLI's sessions get that work in a tab: skills (SKILL.md from
+    // ~/.agents/skills and $CODEX_HOME/skills), web search and image generation (hosted tools on
+    // the model's own route). Not here: git attribution and history notes (ChatGPT's backend),
+    // goals and memories (the SQLite state DB), MCP (no servers configured in the tab).
+    let mut extensions = ExtensionRegistryBuilder::<codex_core::config::Config>::new();
+    codex_web_search_extension::install(&mut extensions, Arc::clone(&auth_manager));
+    codex_image_generation_extension::install(&mut extensions, Arc::clone(&auth_manager), |config: &codex_core::config::Config| {
+        Some(config.codex_home.clone())
+    });
+    codex_skills_extension::install(&mut extensions, |config: &codex_core::config::Config| {
+        codex_skills_extension::SkillsExtensionConfig {
+            include_instructions: config.include_skill_instructions,
+            max_context_tokens: config.skill_max_context_tokens,
+            bundled_skills_enabled: config.bundled_skills_enabled(),
+            cloud_skill_enabled: config.cloud_skill_enabled,
+            shadow_selection_enabled: config.features.enabled(codex_features::Feature::SkillSearch),
+        }
+    });
     let thread_manager = ThreadManager::new(
         &config,
         Arc::clone(&auth_manager),
-- 
