@@ -0,0 +1,111 @@
+//! codex-wasm: the no-follow file operations on wasm32-wasip1, where the file system is the
+//! browser tab's in-memory volume reached through WASI. WASI preview 1 offers no `openat`
+//! with the flags the Unix version relies on, so these refuse symbolic links by checking
+//! `symlink_metadata` first and then use plain `std::fs`.
+
+use crate::FileMetadata;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+fn require_absolute(path: &Path) -> io::Result<()> {
+    if path.is_absolute() {
+        Ok(())
+    } else {
+        Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "no-follow filesystem operations require an absolute path",
+        ))
+    }
+}
+
+fn refuse_symlink(path: &Path) -> io::Result<Option<std::fs::Metadata>> {
+    match std::fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.file_type().is_symlink() => Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "path contains a symbolic link",
+        )),
+        Ok(metadata) => Ok(Some(metadata)),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error),
+    }
+}
+
+fn unix_ms(time: io::Result<SystemTime>) -> i64 {
+    time.ok()
+        .and_then(|t| t.duration_since(UNIX_EPOCH).ok())
+        .and_then(|d| i64::try_from(d.as_millis()).ok())
+        .unwrap_or(0)
+}
+
+pub(super) fn open_file_sync(path: &Path) -> io::Result<std::fs::File> {
+    require_absolute(path)?;
+    refuse_symlink(path)?;
+    let file = std::fs::File::open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "path is not a regular file",
+        ));
+    }
+    Ok(file)
+}
+
+pub(super) async fn write_file(path: PathBuf, contents: Vec<u8>) -> io::Result<()> {
+    require_absolute(&path)?;
+    if let Some(metadata) = refuse_symlink(&path)?
+        && !metadata.is_file()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "path is not a regular file",
+        ));
+    }
+    let mut file = std::fs::File::create(&path)?;
+    file.write_all(&contents)
+}
+
+pub(super) async fn metadata(path: PathBuf) -> io::Result<FileMetadata> {
+    require_absolute(&path)?;
+    let metadata = std::fs::symlink_metadata(&path)?;
+    Ok(FileMetadata {
+        is_directory: metadata.is_dir(),
+        is_file: metadata.is_file(),
+        is_symlink: metadata.file_type().is_symlink(),
+        size: metadata.len(),
+        created_at_ms: unix_ms(metadata.created()),
+        modified_at_ms: unix_ms(metadata.modified()),
+    })
+}
+
+pub(super) async fn create_directory(path: PathBuf, recursive: bool) -> io::Result<()> {
+    require_absolute(&path)?;
+    if recursive {
+        std::fs::create_dir_all(&path)
+    } else {
+        std::fs::create_dir(&path)
+    }
+}
+
+pub(super) async fn remove(path: PathBuf, recursive: bool, force: bool) -> io::Result<()> {
+    require_absolute(&path)?;
+    if recursive {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "recursive no-follow removal is unsupported",
+        ));
+    }
+    let metadata = match refuse_symlink(&path)? {
+        Some(metadata) => metadata,
+        None if force => return Ok(()),
+        None => return Err(io::Error::from(io::ErrorKind::NotFound)),
+    };
+    if metadata.is_dir() {
+        std::fs::remove_dir(&path)
+    } else {
+        std::fs::remove_file(&path)
+    }
+}
