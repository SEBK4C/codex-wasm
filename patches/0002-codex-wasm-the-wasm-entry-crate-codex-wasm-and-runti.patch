--- /dev/null
+++ b/codex-rs/wasm/src/lib.rs
@@ -0,0 +1,294 @@
+#![recursion_limit = "512"]
+//! Codex as a WebAssembly module (wasm32-wasip1) that a browser tab drives.
+//!
+//! The tab provides WASI preview 1 over its in-memory file system, plus `codex_host` imports
+//! for processes (its just-bash shell) and HTTP (`fetch`); see `codex-wasm-host`. Nothing here
+//! blocks: the tab calls `codex_start` once, then `codex_tick` whenever something happened
+//! (`codex_host_wake` marks what) or a timer is due, and each tick runs the ready tasks of a
+//! single-threaded tokio runtime and returns.
+//!
+//! The page talks to Codex through messages (JSON, one per `take_message`):
+//! `{"type":"user","text":…,"model"?:…,"effort"?:…}` starts a turn, or steers the running one;
+//! `{"type":"interrupt"}` stops the turn; `{"type":"shutdown"}` ends the thread.
+//! Codex answers with `{"type":"ready","thread_id"}`, `{"type":"event","event":<Event>}` for
+//! every protocol event, `{"type":"error","message"}` and `{"type":"exit"}`.
+
+use std::cell::RefCell;
+use std::future::poll_fn;
+use std::sync::Arc;
+use std::task::Poll;
+use std::time::Duration;
+use std::time::Instant;
+
+use anyhow::Context;
+use codex_core::config::ConfigBuilder;
+use codex_core::config::ConfigOverrides;
+use codex_core_api::AuthManager;
+use codex_core_api::CodexAppsToolsCache;
+use codex_core_api::CodexHomeUserInstructionsProvider;
+use codex_core_api::EnvironmentManager;
+use codex_core_api::ExecServerRuntimeOptions;
+use codex_core_api::ExtensionRegistryBuilder;
+use codex_core_api::NewThread;
+use codex_core_api::Op;
+use codex_core_api::SessionSource;
+use codex_core_api::StartThreadOptions;
+use codex_core_api::ThreadManager;
+use codex_core_api::ThreadSettingsOverrides;
+use codex_core_api::TurnInputRequest;
+use codex_core_api::UserInput;
+use codex_core_api::build_models_manager;
+use codex_core_api::find_codex_home;
+use codex_core_api::init_state_db;
+use codex_core_api::local_agent_graph_store_from_state_db;
+use codex_core_api::passthrough_image_store;
+use codex_core_api::resolve_installation_id;
+use codex_core_api::thread_store_from_config;
+use codex_protocol::config_types::SandboxMode;
+use codex_protocol::protocol::AskForApproval;
+use serde::Deserialize;
+use serde_json::json;
+
+const DONE: u32 = 0;
+const IDLE: u32 = 1;
+const BUSY: u32 = 2;
+
+thread_local! {
+    static RUNTIME: RefCell<Option<tokio::runtime::Runtime>> = const { RefCell::new(None) };
+    static FINISHED: RefCell<bool> = const { RefCell::new(false) };
+}
+
+fn emit(value: serde_json::Value) {
+    codex_wasm_host::emit(value.to_string().as_bytes());
+}
+
+unsafe extern "C" {
+    fn __wasm_call_ctors();
+}
+
+/// The WASI reactor entry: run static constructors once, before any other export. Exporting
+/// it also keeps the linker from wrapping every export in constructor/destructor calls, as
+/// it does for a command module.
+#[unsafe(no_mangle)]
+pub extern "C" fn _initialize() {
+    unsafe { __wasm_call_ctors() }
+}
+
+/// The tab reports activity on `handle` (a process, a request, or 0 for the inbox).
+#[unsafe(no_mangle)]
+pub extern "C" fn codex_host_wake(handle: u32) {
+    codex_wasm_host::wake(handle);
+}
+
+/// Build the runtime and start Codex. Returns 0, or 1 when it was already started.
+#[unsafe(no_mangle)]
+pub extern "C" fn codex_start() -> u32 {
+    if RUNTIME.with(|r| r.borrow().is_some()) {
+        return 1;
+    }
+    std::panic::set_hook(Box::new(|info| {
+        emit(json!({"type": "panic", "message": info.to_string()}));
+    }));
+    let filter = std::env::var("RUST_LOG").unwrap_or_else(|_| "warn".to_string());
+    let _ = tracing_subscriber::fmt()
+        .with_env_filter(tracing_subscriber::EnvFilter::new(filter))
+        .with_writer(std::io::stderr)
+        .with_ansi(false)
+        .without_time()
+        .try_init();
+
+    let runtime = match tokio::runtime::Builder::new_current_thread()
+        .enable_time()
+        .build()
+    {
+        Ok(runtime) => runtime,
+        Err(error) => {
+            emit(json!({"type": "error", "message": format!("runtime: {error}")}));
+            return 1;
+        }
+    };
+    runtime.spawn(async {
+        if let Err(error) = run().await {
+            emit(json!({"type": "error", "message": format!("{error:#}")}));
+        }
+        emit(json!({"type": "exit"}));
+        FINISHED.with(|f| *f.borrow_mut() = true);
+    });
+    RUNTIME.with(|r| *r.borrow_mut() = Some(runtime));
+    0
+}
+
+/// Run ready tasks for up to `budget_ms`. Returns 2 when more work is ready right away, 1
+/// when everything waits (on the tab or a timer), 0 once Codex has exited.
+#[unsafe(no_mangle)]
+pub extern "C" fn codex_tick(budget_ms: u32) -> u32 {
+    if FINISHED.with(|f| *f.borrow()) {
+        return DONE;
+    }
+    RUNTIME.with(|r| {
+        let runtime = r.borrow();
+        let Some(runtime) = runtime.as_ref() else {
+            return DONE;
+        };
+        let deadline = Instant::now() + Duration::from_millis(u64::from(budget_ms.max(1)));
+        runtime.block_on(async {
+            loop {
+                // Yielding lets every ready task run and the timer wheel turn, without
+                // ever parking (which would block the tab).
+                tokio::task::yield_now().await;
+                let metrics = tokio::runtime::Handle::current().metrics();
+                if metrics.global_queue_depth() == 0 && metrics.worker_local_queue_depth(0) == 0 {
+                    return IDLE;
+                }
+                if Instant::now() >= deadline {
+                    return BUSY;
+                }
+            }
+        })
+    })
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+enum Inbound {
+    User {
+        text: String,
+        #[serde(default)]
+        model: Option<String>,
+    },
+    Interrupt,
+    Shutdown,
+}
+
+async fn next_message() -> Vec<u8> {
+    poll_fn(|cx| match codex_wasm_host::poll_message(cx.waker()) {
+        Some(message) => Poll::Ready(message),
+        None => Poll::Pending,
+    })
+    .await
+}
+
+async fn run() -> anyhow::Result<()> {
+    if let Ok(pwd) = std::env::var("PWD") {
+        std::env::set_current_dir(&pwd).with_context(|| format!("cd {pwd}"))?;
+    }
+    let codex_home = find_codex_home().context("find Codex home")?;
+    let cwd = std::env::current_dir().context("current directory")?;
+    let overrides = ConfigOverrides {
+        cwd: Some(cwd),
+        // The module itself (std's current_exe on WASI names the same path).
+        codex_self_exe: Some(std::env::current_exe().context("current exe")?),
+        // The tab is the sandbox: nothing here reaches the host machine.
+        approval_policy: Some(AskForApproval::Never),
+        sandbox_mode: Some(SandboxMode::DangerFullAccess),
+        ..Default::default()
+    };
+    let config = ConfigBuilder::default()
+        .codex_home(codex_home.to_path_buf())
+        .harness_overrides(overrides)
+        .build()
+        .await
+        .context("load config")?;
+
+    let state_db = init_state_db(&config).await;
+    let auth_manager = AuthManager::shared_from_config(&config, /*enable_codex_api_key_env*/ false)
+        .await
+        .context("auth")?;
+    let local_runtime_paths = ExecServerRuntimeOptions::from_optional_paths(
+        config.codex_self_exe.clone(),
+        config.codex_linux_sandbox_exe.clone(),
+    )
+    .context("exec runtime")?;
+    let thread_store = thread_store_from_config(&config, state_db.clone());
+    let environment_manager = Arc::new(
+        EnvironmentManager::from_codex_home(
+            config.codex_home.clone(),
+            Some(local_runtime_paths),
+            config.http_client_factory(),
+        )
+        .await
+        .context("environments")?,
+    );
+    let installation_id = resolve_installation_id(&config.codex_home).await?;
+    let user_instructions_provider = Arc::new(CodexHomeUserInstructionsProvider::new(
+        config.codex_home.clone(),
+    ));
+    let extensions = ExtensionRegistryBuilder::<codex_core::config::Config>::new();
+    let thread_manager = ThreadManager::new(
+        &config,
+        Arc::clone(&auth_manager),
+        build_models_manager(&config, auth_manager),
+        CodexAppsToolsCache::default(),
+        SessionSource::Exec,
+        environment_manager,
+        Arc::new(extensions.build()),
+        user_instructions_provider,
+        /*analytics_events_client*/ None,
+        passthrough_image_store(),
+        Arc::clone(&thread_store),
+        local_agent_graph_store_from_state_db(state_db.as_ref()),
+        installation_id,
+        /*attestation_provider*/ None,
+        /*external_time_provider*/ None,
+    );
+
+    let NewThread {
+        thread_id, thread, ..
+    } = thread_manager
+        .start_thread(StartThreadOptions::new(config))
+        .await
+        .context("start Codex thread")?;
+    emit(json!({"type": "ready", "thread_id": thread_id.to_string()}));
+
+    let events = {
+        let thread = Arc::clone(&thread);
+        tokio::spawn(async move {
+            loop {
+                match thread.next_event().await {
+                    Ok(event) => emit(json!({"type": "event", "event": event})),
+                    Err(error) => {
+                        emit(json!({"type": "error", "message": format!("events: {error}")}));
+                        break;
+                    }
+                }
+            }
+        })
+    };
+
+    loop {
+        let raw = next_message().await;
+        let message: Inbound = match serde_json::from_slice(&raw) {
+            Ok(message) => message,
+            Err(error) => {
+                emit(json!({"type": "error", "message": format!("bad message: {error}")}));
+                continue;
+            }
+        };
+        match message {
+            Inbound::User { text, model } => {
+                let request = TurnInputRequest::user_input(vec![UserInput::Text {
+                    text,
+                    text_elements: Vec::new(),
+                }])
+                .with_thread_settings(ThreadSettingsOverrides {
+                    model,
+                    ..Default::default()
+                });
+                if let Err(error) = thread.start_or_steer_turn(request).await {
+                    emit(json!({"type": "error", "message": format!("turn: {error}")}));
+                }
+            }
+            Inbound::Interrupt => {
+                if let Err(error) = thread.submit(Op::Interrupt).await {
+                    emit(json!({"type": "error", "message": format!("interrupt: {error}")}));
+                }
+            }
+            Inbound::Shutdown => break,
+        }
+    }
+
+    let _ = thread.shutdown_and_wait().await;
+    events.abort();
+    let _ = thread_manager.remove_thread(&thread_id).await;
+    Ok(())
+}
